# Servidor
NODE_ENV=development
PORT=3000
SERVE_FRONTEND=true
FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:5174

# Segurança (altere em produção)
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
ADMIN_JWT_SECRET=change-me-admin-in-production
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET_EXPIRES_IN=7d

# Banco multi-tenant (SQLite)
DATABASE_STORAGE=./backend/database/tenants

# E-mail (opcional)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="MAM Control <noreply@example.com>"
RESEND_API_KEY=

# Push service (equipamentos)
PUSH_SERVICE_URL=http://127.0.0.1:3001
PUSH_PORT=3001
PUSH_HOST=127.0.0.1

# Produção / HTTPS (opcional)
USE_HTTPS=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=3000

# Backup
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
